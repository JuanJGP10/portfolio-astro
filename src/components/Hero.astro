---
import "../styles/hero.css";
import yoImg from "../assets/yo.jpg";

const contactLinks = [
  {
    label: "Email",
    href: "mailto:jjgphillips1@gmail.com",
    icon: "fa-solid fa-envelope",
  },
  {
    label: "GitHub",
    href: "https://github.com/JuanJGP10",
    icon: "fa-brands fa-github",
  },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/juan-garc%C3%ADa-phillips-58a418370/",
    icon: "fa-brands fa-linkedin-in",
  },
];
---

<section id="hero" class="hero">
  <div class="hero-blob hero-blob-a" aria-hidden="true"></div>
  <div class="hero-blob hero-blob-b" aria-hidden="true"></div>
  <div class="hero-blob hero-blob-c" aria-hidden="true"></div>
  <div class="container hero-container">
    <h1 class="hero-title">Juan García Phillips</h1>
    <p class="hero-subtitle">Fullstack Developer</p>

    <div class="hero-bio-row">
      <p class="hero-bio">
        Recién titulado de DAM (Desarrollo de Aplicaciones Multiplataforma) vivo en Alicante.
      </p>
      <img
        class="hero-photo"
        src={yoImg.src}
        width={yoImg.width}
        height={yoImg.height}
        alt="Juan García Phillips"
      />
    </div>

    <div class="hero-contact">
      {
        contactLinks.map((link) => (
          <a
            class="hero-contact-link"
            href={link.href}
            target={link.href.startsWith("http") ? "_blank" : undefined}
            rel={
              link.href.startsWith("http") ? "noopener noreferrer" : undefined
            }
            aria-label={link.label}
          >
            <i class={link.icon} aria-hidden="true" />
            {link.label}
          </a>
        ))
      }
    </div>

  </div>
</section>
