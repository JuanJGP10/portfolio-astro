---
import '../styles/contact.css';

const contactLinks = [
  {
    label: 'Email',
    value: 'jjgphillips1@gmail.com',
    href: 'mailto:jjgphillips1@gmail.com',
  },
  {
    label: 'GitHub',
    value: 'github.com/JuanJGP10',
    href: 'https://github.com/JuanJGP10',
  },
  {
    label: 'LinkedIn',
    value: 'linkedin.com/in/juan-garc%C3%ADa-phillips-58a418370',
    href: 'https://www.linkedin.com/in/juan-garc%C3%ADa-phillips-58a418370/',
  },
];

const year = new Date().getFullYear();
---

<section id="contact" class="contact">
  <div class="container">
    <h2 class="section-title">Contacto</h2>
    <p class="contact-intro">
      Frase contacto
    </p>
    <ul class="contact-list">
      {contactLinks.map(link => (
        <li class="contact-item">
          <span class="contact-label">{link.label}</span>
          <a
            class="contact-link"
            href={link.href}
            target={link.href.startsWith('http') ? '_blank' : undefined}
            rel={link.href.startsWith('http') ? 'noopener' : undefined}
          >
            {link.value}
          </a>
        </li>
      ))}
    </ul>
    <footer class="contact-footer">
      <p>Construido con Astro · {year}</p>
    </footer>
  </div>
</section>
