---
import "../styles/navbar.css";

const socialLinks = [
  {
    label: "Email",
    href: "mailto:jjgphillips1@gmail.com",
    icon: "fa-solid fa-envelope",
  },
  {
    label: "GitHub",
    href: "https://github.com/JuanJGP10",
    icon: "fa-brands fa-github",
  },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/juan-garc%C3%ADa-phillips-58a418370/",
    icon: "fa-brands fa-linkedin-in",
  },
];
---

<nav class="nav">
  <div class="nav-container">
    <ul class="nav-links">
      <li><a class="nav-link" href="#experience"   data-i18n="nav.experience">Experiencia</a></li>
      <li><a class="nav-link" href="#projects"     data-i18n="nav.projects">Proyectos</a></li>
      <li><a class="nav-link" href="#technologies" data-i18n="nav.technologies">Tecnologías</a></li>
    </ul>
    <div class="nav-divider" aria-hidden="true"></div>
    <div class="nav-socials">
      {
        socialLinks.map((link) => (
          <a
            class="nav-social-link"
            href={link.href}
            target={link.href.startsWith("http") ? "_blank" : undefined}
            rel={
              link.href.startsWith("http") ? "noopener noreferrer" : undefined
            }
            aria-label={link.label}
          >
            <i class={link.icon} aria-hidden="true" />
          </a>
        ))
      }
    </div>
    <div class="nav-divider" aria-hidden="true"></div>
    <div class="lang-switch" role="group" aria-label="Language / Idioma" id="lang-switch">
      <span class="lang-switch-track" aria-hidden="true"></span>
      <button class="lang-switch-btn" data-lang-btn="es">ES</button>
      <button class="lang-switch-btn" data-lang-btn="en">EN</button>
    </div>
  </div>
</nav>

<script>
  import { setLang, getLang, type Lang } from '../scripts/i18n-client';

  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-lang-btn]');

  function updateActive(lang: Lang) {
    buttons.forEach((btn) => {
      btn.classList.toggle('lang-switch-btn--active', btn.dataset.langBtn === lang);
    });
  }

  updateActive(getLang());

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const lang = btn.dataset.langBtn as Lang;
      setLang(lang);
      updateActive(lang);
    });
  });
</script>
